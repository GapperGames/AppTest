<?xml version="1.0" encoding="utf-8"?>
<!-- Default control: felt-green "glass" pill with a top-lit gradient,
     a hairline highlight edge, and a pressed state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF2C9165"
                android:endColor="#FF14603F" />
            <stroke android:width="1dp" android:color="#5CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="270"
                android:startColor="#E61E7A50"
                android:endColor="#E60E4A30" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
