{
  "name": "@trainer/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fetch chess.com games, analyse openings with Stockfish, emit a weighted openings tree.",
  "bin": {
    "openings-pipeline": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "sample": "tsx src/index.ts --pgn ../data/sample-games.pgn --user SampleUser --out ../app/public/openings.json --depth 12 --max-ply 12",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
